# CV Hunter — Variables d'Entorn
# Copia aquest fitxer a .env i omple els valors

# Seguretat
SECRET_KEY=canvia-aquesta-clau-aleatoria-llarga-en-produccio
APP_ENV=development

# Base de dades PostgreSQL
DATABASE_URL=postgresql+asyncpg://cvhunter:cvhunter@localhost:5432/cvhunter

# Redis
REDIS_URL=redis://localhost:6379/0

# IA — proveïdor: ollama (models locals, sense clau) o anthropic
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434        # amb docker compose: http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b                  # sense GPU: qwen2.5:3b (més ràpid, menys precís)

# Només si LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# CORS (URLs del frontend)
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000","https://gemmagf.github.io"]

# URL pública del frontend: s'usa per construir els enllaços de les mini-proves (/#/prova/<token>)
PUBLIC_APP_URL=http://localhost:5173

# Free Trial
FREE_TRIAL_DAYS=30
FREE_TRIAL_CV_LIMIT=50
